# ==============================================================================
# ClearCue Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (MongoDB Atlas)
# ------------------------------------------------------------------------------
# Set your MongoDB Atlas connection string here for production cloud persistence.
# If omitted or offline, ClearCue automatically falls back to local SQLite persistent store (data/clearcue.db).
# Example: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/clearcue?retryWrites=true&w=majority
MONGODB_URI="mongodb+srv://<username>:<password>@<cluster>.mongodb.net/clearcue?retryWrites=true&w=majority"

# ------------------------------------------------------------------------------
# 2. AUTHENTICATION & SECURITY (JWT)
# ------------------------------------------------------------------------------
# Secret key used for signing JWT authentication tokens (7-day validity).
# In production on Render, set this to a secure random string (e.g. openssl rand -base64 32).
JWT_SECRET="clearcue_jwt_secret_change_in_production_2026"

# ------------------------------------------------------------------------------
# 3. BACKEND SERVER (Render / Local)
# ------------------------------------------------------------------------------
# Port for backend service (Render injects this dynamically).
PORT=3000
NODE_ENV="development"

# ------------------------------------------------------------------------------
# 4. FRONTEND DEPLOYMENT (GitHub Pages)
# ------------------------------------------------------------------------------
# In production on GitHub Pages, set VITE_API_URL to your Render backend service URL.
# During local development, leave this empty to proxy to local /api routes.
# Example: https://clearcue-backend.onrender.com
VITE_API_URL=""

# ------------------------------------------------------------------------------
# 5. AI ENGINE (100% Free / Optional Gemini Hybrid Fallback)
# ------------------------------------------------------------------------------
# ClearCue runs 100% operational with $0 paid tools using its built-in local
# NLP heuristic and phonetic evaluators. If you wish to enable Google Gemini API
# features as a hybrid enhancement, provide your free tier API key below:
GEMINI_API_KEY=""
